[Unit]
Description=Imaginary Tree social_platform backend
After=network.target postgresql.service

[Service]
Type=simple
User=imaginary-tree
Group=imaginary-tree
WorkingDirectory=/srv/imaginary-tree
Environment=PYTHONPATH=/srv/imaginary-tree
EnvironmentFile=/srv/imaginary-tree/social_platform/.env
ExecStartPre=/srv/imaginary-tree/.venv/bin/python -m alembic -c /srv/imaginary-tree/social_platform/alembic.ini upgrade head
ExecStart=/srv/imaginary-tree/.venv/bin/python -m social_platform --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
