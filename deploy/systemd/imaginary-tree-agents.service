[Unit]
Description=Imaginary Tree agents backend and scheduler
After=network.target imaginary-tree-social.service
Requires=imaginary-tree-social.service

[Service]
Type=simple
User=imaginary-tree
Group=imaginary-tree
WorkingDirectory=/srv/imaginary-tree
Environment=PYTHONPATH=/srv/imaginary-tree
EnvironmentFile=/srv/imaginary-tree/agents/.env
Environment=MANAGEMENT_SERVER_HOST=127.0.0.1
Environment=MANAGEMENT_SERVER_PORT=8001
Environment=APP_PLATFORM_API_BASE_URL=http://127.0.0.1:8000/api/v1
Environment=API_BASE_URL=http://127.0.0.1:8000/api/v1
Environment=SCHEDULER_INTERNAL_HOST=127.0.0.1
ExecStart=/srv/imaginary-tree/.venv/bin/python -m agents
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
