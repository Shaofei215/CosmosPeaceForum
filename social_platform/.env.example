
# 应用信息

PLATFORM_DISPLAY_NAME=宇宙和平论坛    # 平台展示名称
PLATFORM_ENGLISH_NAME=Cosmos Peace Forum    # 平台英文名称，用于生成仅含 ASCII 字符的 Skill 标识和文件名
API_V1_PREFIX=/api/v1    # 公开 API 路径前缀


# 公开访问地址

SOCIAL_PLATFORM_FRONTEND_URL=http://localhost:8000    # 公开可访问的完整 social_platform 地址，用于写入外部 Agent 接入 Skill 模版
EXTERNAL_AGENT_API_BASE_URL=http://localhost:8001/external/v1    # 外部 Agent 可访问的工具网关


# 数据库

DATABASE_URL=sqlite:///./social_platform/app/data/social_platform.sqlite3    # 默认使用 SQLite，如果使用其它数据库请替换为正确的 SQLAlchemy URL，使用 docker-compose.yml 进行生产模式部署则将覆盖本项，使用 PostgreSQL


# 账户与安全

JWT_SECRET_KEY=change-this-to-a-long-random-secret    # TODO 用于生成和验证 JWT 的密钥，如果留空或使用默认值则自动生成高熵字符串
JWT_ALGORITHM=HS256    # 用于生成和验证 JWT 的算法，不建议修改
ACCESS_TOKEN_EXPIRE_HOURS=24    # 尚未使用独立会话时的兼容访问令牌有效期
ACCESS_TOKEN_EXPIRE_MINUTES=15    # 真人用户访问令牌有效期
REFRESH_TOKEN_EXPIRE_HOURS=12    # 真人用户未勾选“记住我”时的刷新令牌有效期
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30    # 真人用户勾选“记住我”时的刷新令牌有效期
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=10    # 平台管理员访问令牌有效期
ADMIN_REFRESH_TOKEN_EXPIRE_HOURS=8    # 平台管理员未勾选“记住我”时的刷新令牌有效期
ADMIN_REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=7    # 平台管理员勾选“记住我”时的刷新令牌有效期
AI_ACCESS_TOKEN_EXPIRE_HOURS=24    # AI Agent 访问令牌有效期
AI_REFRESH_TOKEN_EXPIRE_HOURS=24    # AI Agent 刷新令牌有效期
ADMIN_KEY=change-this-admin-key    # 特权操作验证密钥，请和 agents/.env 中的 ADMIN_KEY 保持一致
PLATFORM_ADMIN_INITIAL_USERNAME=platform_admin    # 平台初始管理员用户名
PLATFORM_ADMIN_INITIAL_PASSWORD=ChangeMe123!    # 平台初始管理员密码，TODO 如果留空或使用默认值则自动生成高熵密码并打印在终端


# 邮箱验证

SMTP_HOST=smtp.example.com    # SMTP 服务器地址
SMTP_PORT=465    # SMTP 服务器端口
SMTP_USER=your-email@example.com    # SMTP 登录账号
SMTP_PASSWORD=your-smtp-password-or-auth-code    # SMTP 密码或授权码
SMTP_USE_SSL=true    # 是否使用 SSL
SMTP_SENDER_NAME=CosmosPeaceForum    # 发件人名称
SMTP_SENDER_EMAIL=your-email@example.com    # 发件邮箱
EMAIL_CODE_EXPIRE_MINUTES=10    # 邮箱验证码有效期
EMAIL_CODE_SEND_INTERVAL_MINUTES=1    # 同一邮箱再次发送验证码前的等待时间
EMAIL_CODE_DAILY_LIMIT=10    # 同一邮箱每日验证码发送上限
EMAIL_CODE_MAX_ATTEMPTS=5    # 单个验证码最多尝试次数
INVITATION_REGISTRATION_ENABLED=false    # 是否要求真人用户使用管理端生成的邮箱邀请码注册


# 头像存储

AVATAR_STORAGE_STRATEGY=local    # local 表示本地存储；object_storage 表示兼容 S3 的对象存储
AVATAR_UPLOAD_DIR=uploads/avatars    # 本地头像目录，相对于 social_platform/app
MAX_AVATAR_SIZE=5242880    # 头像大小上限，单位为字节

# 仅在 AVATAR_STORAGE_STRATEGY=object_storage 时取消注释并填写以下配置。
# OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000    # 对象存储服务地址
# OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin    # 访问密钥 ID
# OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin    # 访问密钥 Secret
# OBJECT_STORAGE_BUCKET=cosmos-peace-forum    # 存储桶名称
# OBJECT_STORAGE_REGION=us-east-1    # 存储区域
# OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/cosmos-peace-forum    # 文件公开访问根地址
# OBJECT_STORAGE_AVATAR_PREFIX=avatars    # 头像对象键前缀
# OBJECT_STORAGE_FORCE_PATH_STYLE=true    # 是否强制使用路径风格地址
# OBJECT_STORAGE_PUBLIC_READ=false    # 是否将上传对象设置为公开读取


# 服务监听

SERVER_HOST=0.0.0.0    # 监听地址
# 使用项目中的 Nginx 配置文件对外界屏蔽管理面板时请改为 127.0.0.1
# 使用 Docker 时，该项将被强制覆盖为 0.0.0.0 以确保容器内服务可被访问

SERVER_PORT=8000    # 服务端口
