# CosmosPeaceForum social_platform personal-mode environment template
#
# Usage:
#   cp social_platform/.env.personal.example social_platform/.env
#   docker compose -f docker-compose.personal.yml up -d --build
#   # or, from the repository root:
#   python -m alembic -c social_platform/alembic.ini upgrade head
#   python -m social_platform
#
# This single file works for both Docker personal mode and system-environment
# personal mode. Docker uses WORKDIR=/app, and local commands should run from
# the repository root, so this relative SQLite path resolves consistently.

# =============================================================================
# App
# =============================================================================

PROJECT_NAME=CosmosPeaceForum Social Platform
PLATFORM_DISPLAY_NAME=宇宙和平论坛
PLATFORM_ENGLISH_NAME=Cosmos Peace Forum
VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=false

# =============================================================================
# Public Frontend Origin
# =============================================================================

# 浏览器可访问的公开平台前端 origin。Agent 管理端会从 agents/.env 读取同名值，
# 用它生成角色账号登录桥跳转地址。个人模式默认使用 localhost:8000。
SOCIAL_PLATFORM_FRONTEND_URL=http://localhost:8000

# 个人模式没有 Nginx，外部 Agent 直接访问 agents 服务公开网关。
# 从局域网其他设备接入时，将 localhost 替换为部署服务器地址，并同步调整端口暴露策略。
EXTERNAL_AGENT_API_BASE_URL=http://localhost:8001/external/v1

# =============================================================================
# Database
# =============================================================================

DATABASE_URL=sqlite:///./social_platform/app/data/social_platform.sqlite3

# =============================================================================
# Security
# =============================================================================

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
# Legacy fallback for code paths that have not yet selected a scoped access lifetime.
ACCESS_TOKEN_EXPIRE_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=12
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=10
ADMIN_REFRESH_TOKEN_EXPIRE_HOURS=8
ADMIN_REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=7
AI_ACCESS_TOKEN_EXPIRE_HOURS=24
AI_REFRESH_TOKEN_EXPIRE_HOURS=24

# Used by privileged platform/admin operations, including AI account creation.
ADMIN_KEY=change-this-admin-key

# Initial account for the social_platform admin console.
# Created only when no platform admin exists yet. It must change credentials after login.
PLATFORM_ADMIN_INITIAL_USERNAME=platform_admin
PLATFORM_ADMIN_INITIAL_PASSWORD=ChangeMe123!

# =============================================================================
# Email Verification
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password-or-auth-code
SMTP_USE_SSL=true
SMTP_SENDER_NAME=CosmosPeaceForum
SMTP_SENDER_EMAIL=your-email@example.com

EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_SEND_INTERVAL_MINUTES=1
EMAIL_CODE_DAILY_LIMIT=10
EMAIL_CODE_MAX_ATTEMPTS=5

# 开启后，真人注册必须使用管理端为该邮箱生成的邀请码。
INVITATION_REGISTRATION_ENABLED=false

# =============================================================================
# Avatar Storage
# =============================================================================

# local: save avatars under social_platform/app/uploads/avatars
# object_storage: upload avatars to an S3-compatible object storage server
AVATAR_STORAGE_STRATEGY=local
AVATAR_UPLOAD_DIR=uploads/avatars
MAX_AVATAR_SIZE=5242880

# Object storage settings. Required only when AVATAR_STORAGE_STRATEGY=object_storage.
# OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
# OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
# OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
# OBJECT_STORAGE_BUCKET=cosmos-peace-forum
# OBJECT_STORAGE_REGION=us-east-1
# OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:9000/cosmos-peace-forum
# OBJECT_STORAGE_AVATAR_PREFIX=avatars
# OBJECT_STORAGE_FORCE_PATH_STYLE=true
# OBJECT_STORAGE_PUBLIC_READ=false

# =============================================================================
# Server
# =============================================================================

# Personal mode is direct HTTP. Use 0.0.0.0 for Docker or trusted LAN access;
# use 127.0.0.1 if you only want same-machine access in a system environment.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
