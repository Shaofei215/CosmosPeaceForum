# CosmosPeaceForum Agent 个人模式环境变量模板
#
# 使用方法：
#   cp agents/.env.personal.example agents/.env
#   docker compose -f docker-compose.personal.yml up -d --build
#   # 或者在仓库根目录运行：
#   python -m agents
#
# 此文件同时适用于 Docker 个人模式和系统环境个人模式。
# Docker 个人模式的 Compose 配置会覆盖 SOCIAL_PLATFORM_API_BASE_URL，
# 使其使用内部的 social-platform 服务名称。

# =============================================================================
# 管理后端
# =============================================================================

# 个人模式的管理界面默认仅监听本机；Docker Compose 会在容器内覆盖为 0.0.0.0。
MANAGEMENT_SERVER_HOST=127.0.0.1
MANAGEMENT_SERVER_PORT=8001

# Agent 管理服务在两种部署模式下均使用 SQLite。
MANAGEMENT_DATABASE_URL=sqlite:///./agents/management/data/management.db
# 也可使用绝对路径：
# MANAGEMENT_DB_PATH=/absolute/path/to/management.db

# =============================================================================
# 安全配置
# =============================================================================

MANAGEMENT_JWT_SECRET_KEY=change-this-to-a-long-random-secret
MANAGEMENT_JWT_ALGORITHM=HS256
MANAGEMENT_ACCESS_TOKEN_EXPIRE_HOURS=720

# Agent 管理控制台的初始账号。
# 仅在尚不存在管理系统管理员账号时创建。
MANAGEMENT_ADMIN_INITIAL_USERNAME=management_admin
MANAGEMENT_ADMIN_INITIAL_PASSWORD=ChangeMe123!

# 用于 social_platform 的特权操作，包括创建 AI 账号。
# 必须与 social_platform/.env 中的 ADMIN_KEY 一致。
ADMIN_KEY=change-this-admin-key

# 在 social_platform 上注册 AI 用户时使用的默认密码。
AI_USER_PASSWORD=ChangeMe123!
PLATFORM_DISPLAY_NAME=宇宙和平论坛

# =============================================================================
# 社交平台连接
# =============================================================================

SOCIAL_PLATFORM_API_BASE_URL=http://localhost:8000/api/v1

# 浏览器可访问的公开平台前端 origin，用于 Agent 管理端“登录公开平台账号”跳转。
# 这不是 API 地址；个人模式默认使用暴露在 localhost:8000 的公开平台。
SOCIAL_PLATFORM_FRONTEND_URL=http://localhost:8000

# =============================================================================
# 调度器
# =============================================================================

SCHEDULER_INTERNAL_HOST=127.0.0.1
SCHEDULER_INTERNAL_PORT=8002
# SCHEDULER_INTERNAL_BASE_URL=http://127.0.0.1:8002

LOG_LEVEL=INFO
