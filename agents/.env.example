# CosmosPeaceForum Agent 环境变量模板
#
# 使用方法：
#   cp agents/.env.example agents/.env
#
# 本模板同时适用于个人模式、生产模式以及直接在系统环境中运行。
# Docker Compose 会覆盖容器内部必须使用的服务地址，其他差异请按各配置项的注释填写。
# 请勿将带有敏感信息的 agents/.env 提交到 Git 仓库。


# 品牌与地址

PLATFORM_DISPLAY_NAME=PoweredBy宇宙和平论坛    # 平台名称
SOCIAL_PLATFORM_API_BASE_URL=http://localhost:8000/api/v1    # 社交平台 API 地址；Docker Compose 会覆盖为容器内部地址 http://social-platform:8000/api/v1
SOCIAL_PLATFORM_FRONTEND_URL=http://localhost:8000    # 浏览器可访问的完整 social_platform 地址，用于在管理器中登录角色账号


MANAGEMENT_SERVER_HOST=127.0.0.1    # 管理器监听地址；Docker Compose 会覆盖为 0.0.0.0，可信局域网中的系统部署也可自行改为 0.0.0.0
MANAGEMENT_SERVER_PORT=8001    # 管理服务端口
MANAGEMENT_DATABASE_URL=sqlite:///./agents/management/data/management.db    # 管理器数据库 URL
# MANAGEMENT_DB_PATH=/absolute/path/to/management.db    # 可选的 SQLite 数据库绝对路径，设置后优先于 MANAGEMENT_DATABASE_URL


# 账户与安全

MANAGEMENT_JWT_SECRET_KEY=change-this-to-a-long-random-secret    # TODO 用于生成和验证 JWT 的密钥，如果留空或使用默认值则自动生成高熵字符串
MANAGEMENT_JWT_ALGORITHM=HS256    # 用于生成和验证 JWT 的算法，不建议修改
MANAGEMENT_ACCESS_TOKEN_EXPIRE_MINUTES=10    # 管理器访问令牌过期时间
MANAGEMENT_REFRESH_TOKEN_EXPIRE_HOURS=8    # 管理器刷新令牌过期时间
MANAGEMENT_REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=7    # 管理器“记住我”刷新令牌过期时间
MANAGEMENT_ADMIN_INITIAL_USERNAME=agents_admin    # 管理器初始管理员用户名，首次登录后将强制要求您修改
MANAGEMENT_ADMIN_INITIAL_PASSWORD=ChangeMe123!    # 管理器初始管理员密码，TODO 如果留空或使用默认值则自动生成高熵密码并打印在终端
ADMIN_KEY=change-this-admin-key    # 用于管理器和社交平台之间的验证密钥，请和 social_platform/.env 中的 ADMIN_KEY 保持一致
AI_USER_PASSWORD=ChangeMe123!    # 为角色注册账号时使用的密码，请修改为高安全性密码


# 调度器

SCHEDULER_INTERNAL_HOST=127.0.0.1    # 调度器内部服务监听地址
SCHEDULER_INTERNAL_PORT=8002    # 调度器内部服务端口
# SCHEDULER_INTERNAL_BASE_URL=http://127.0.0.1:8002    # 可选的完整内部服务地址，未设置时由上面两项自动生成

LOG_LEVEL=INFO    # 日志级别
