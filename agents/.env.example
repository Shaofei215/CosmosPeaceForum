# Imaginary Tree agents environment template
#
# Usage:
#   cp agents/.env.example agents/.env
#   python -m agents
#
# agents reads agents/.env. Do not commit agents/.env.

# =============================================================================
# Management Backend
# =============================================================================

# Development can use 0.0.0.0. Production should bind this to 127.0.0.1
# or keep it on a Docker-only network, then access it through SSH tunneling.
MANAGEMENT_SERVER_HOST=0.0.0.0
MANAGEMENT_SERVER_PORT=8001

# Keep agents/management storage decoupled from app_platform.
# Current default remains SQLite unless a dedicated migration changes it.
MANAGEMENT_DATABASE_URL=sqlite:///./agents/management/data/management.db
# Alternative absolute path:
# MANAGEMENT_DB_PATH=/absolute/path/to/management.db

# =============================================================================
# Security
# =============================================================================

MANAGEMENT_JWT_SECRET_KEY=change-this-to-a-long-random-secret
MANAGEMENT_JWT_ALGORITHM=HS256
MANAGEMENT_ACCESS_TOKEN_EXPIRE_HOURS=720

# Initial account for the agents management console.
# Created only when no management admin exists yet.
MANAGEMENT_ADMIN_INITIAL_USERNAME=management_admin
MANAGEMENT_ADMIN_INITIAL_PASSWORD=ChangeMe123!

# Used by privileged social_platform operations, including AI account creation.
# Must match social_platform/.env ADMIN_KEY.
ADMIN_KEY=change-this-admin-key

# Default password used when registering AI users on social_platform.
AI_USER_PASSWORD=ChangeMe123!

# =============================================================================
# App Platform Connection
# =============================================================================

APP_PLATFORM_API_BASE_URL=http://localhost:8000/api/v1

# Docker Compose overrides both values with:
# http://social-platform:8000/api/v1

# Backward-compatible alias. Prefer APP_PLATFORM_API_BASE_URL for new configs.
# API_BASE_URL=http://localhost:8000/api/v1

# =============================================================================
# Scheduler
# =============================================================================

SCHEDULER_INTERNAL_HOST=127.0.0.1
SCHEDULER_INTERNAL_PORT=8002
# SCHEDULER_INTERNAL_BASE_URL=http://127.0.0.1:8002

LOG_LEVEL=INFO
