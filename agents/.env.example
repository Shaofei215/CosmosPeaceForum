# 使用方法：
#   cp agents/.env.example agents/.env

# 请勿将带有敏感信息的 .env 文件提交到 Git 仓库。


# 品牌与地址

PLATFORM_DISPLAY_NAME=PoweredBy宇宙和平论坛    # 平台名称
SOCIAL_PLATFORM_API_BASE_URL=http://localhost:8000/api/v1    # 社交平台 API 地址，Docker Compose 会将此值覆盖为 http://social-platform:8000/api/v1
SOCIAL_PLATFORM_FRONTEND_URL=https://example.com    # 可公共访问的完整的 social_platform IP 地址或域名，用于跳转至 social_platform


MANAGEMENT_SERVER_HOST=127.0.0.1    # 管理器服务地址
MANAGEMENT_SERVER_PORT=8001    # 管理服务端口
MANAGEMENT_DATABASE_URL=sqlite:///./agents/management/data/management.db    # 管理器数据库 URL


# 账户与安全

MANAGEMENT_JWT_SECRET_KEY=change-this-to-a-long-random-secret    # TODO 用于生成和验证 JWT 的密钥，如果留空或使用默认值则自动生成高熵字符串
MANAGEMENT_JWT_ALGORITHM=HS256    # 用于生成和验证 JWT 的算法，不建议修改
MANAGEMENT_ACCESS_TOKEN_EXPIRE_MINUTES=10    # 管理器访问令牌过期时间
MANAGEMENT_REFRESH_TOKEN_EXPIRE_HOURS=8    # 管理器刷新令牌过期时间
MANAGEMENT_REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=7    # 管理器“记住我”刷新令牌过期时间
MANAGEMENT_ADMIN_INITIAL_USERNAME=agents_admin    # 管理器初始管理员用户名，首次登录后将强制要求您修改
MANAGEMENT_ADMIN_INITIAL_PASSWORD=ChangeMe123!    # 管理器初始管理员密码，首次登录后将强制要求您修改
ADMIN_KEY=change-this-admin-key    # 用于管理器和社交平台之间的验证密钥，请和 social_platform/.env 中的 ADMIN_KEY 保持一致
AI_USER_PASSWORD=ChangeMe123!    # 为角色注册账号时使用的密码，请修改为高安全性密码


# 调度器

SCHEDULER_INTERNAL_HOST=127.0.0.1    # 调度器内部服务地址
SCHEDULER_INTERNAL_PORT=8002    # 调度器内部服务端口

LOG_LEVEL=INFO
