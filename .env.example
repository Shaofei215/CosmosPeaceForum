# Imaginary Tree environment template
#
# Usage for local app_platform development:
#   cp .env.example .env
#   python -m uvicorn app_platform.app.main:app --host 0.0.0.0 --port 8000
#
# Important:
# app_platform.app.core.config.Settings currently rejects unknown keys.
# Keep root .env / app_platform/.env limited to the uncommented backend keys below.
# Frontend, management, and scheduler examples are commented out later in this file.

# =============================================================================
# app_platform backend
# =============================================================================

PROJECT_NAME=ImaginaryTree-Tree Social Platform
VERSION=0.1.0
API_V1_PREFIX=/api/v1
DEBUG=true

# Local SQLite database used when starting uvicorn from the repository root.
DATABASE_URL=sqlite:///./app_platform/app/data/imaginary_tree.db

# Docker alternative:
# DATABASE_URL=sqlite:///./data/imaginary_tree.db

JWT_SECRET_KEY=change-this-local-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# Used by privileged platform/admin operations, including AI account creation.
ADMIN_KEY=123456

# Email verification settings.
# These fields are required at import time even if you do not send real email locally.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-smtp-password-or-auth-code
SMTP_USE_SSL=true
SMTP_SENDER_NAME=Imaginary Tree
SMTP_SENDER_EMAIL=your-email@example.com

EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_SEND_INTERVAL_MINUTES=1
EMAIL_CODE_DAILY_LIMIT=10
EMAIL_CODE_MAX_ATTEMPTS=5

# Optional app_platform settings with code defaults.
AVATAR_UPLOAD_DIR=uploads/avatars
MAX_AVATAR_SIZE=5242880
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# =============================================================================
# frontend examples
# =============================================================================
#
# Put this in frontend/.env, not in root .env when running app_platform from root.
#
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# =============================================================================
# agents/management/frontend examples
# =============================================================================
#
# Put this in agents/management/frontend/.env.
#
# VITE_API_BASE_URL=http://localhost:8001/api

# =============================================================================
# agents/management/backend optional environment
# =============================================================================
#
# The management backend mostly uses code defaults and stores runtime settings in
# agents/management/data/management.db. This optional key may be exported in the
# shell before starting the management backend; do not put it in app_platform .env.
#
# MANAGEMENT_JWT_SECRET_KEY=change-this-management-jwt-secret

# =============================================================================
# scheduler runtime settings
# =============================================================================
#
# Scheduler business settings are stored in the management database system_config
# table and can be edited from the management UI:
#
# ADMIN_KEY
# AI_USER_PASSWORD
# API_BASE_URL
# LOG_LEVEL
# LANGGRAPH_MAX_STEPS
# LANGGRAPH_MAX_CONSECUTIVE_ERRORS
# LANGGRAPH_TOOL_TIMEOUT
# MEMORY_ENABLED
# MEMORY_RECALL_LIMIT
# MEMORY_RECALL_VECTOR_RESULTS
# MEMORY_RECALL_BM25_RESULTS
# MEMORY_THRESHOLD
# MEMORY_BOOST_FACTOR
# MEMORY_DECAY_RATE
#
# Embedding provider settings are managed via the management backend embedding
# configuration APIs/database, not by root .env.
