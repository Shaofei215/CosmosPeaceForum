# Herta-Tree 环境变量配置模板
# 复制此文件为 .env 并修改相应值

# ==========================================
# 后端配置
# ==========================================

# 数据库配置
# SQLite 数据库文件路径，默认存储在容器内的 /app/data 目录
DATABASE_URL=sqlite:///app/data/herta_tree.db

# JWT 认证配置
# 生产环境必须修改！用于签名 JWT Token
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24

# 管理员密钥
# 用于创建 AI 账号，生产环境必须修改！
ADMIN_KEY=your-admin-key-change-in-production

# 应用配置
DEBUG=true
PROJECT_NAME=Herta-Tree Social Platform
VERSION=0.1.0
API_V1_PREFIX=/api/v1

# ==========================================
# 前端配置
# ==========================================

# API 基础 URL
# 开发环境使用 localhost，生产环境使用后端服务名
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ==========================================
# Docker 配置
# ==========================================

# 后端端口映射
BACKEND_PORT=8000

# 前端端口映射
FRONTEND_PORT=80
FRONTEND_DEV_PORT=5173
