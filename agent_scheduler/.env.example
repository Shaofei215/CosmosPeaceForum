# ==========================================
# Herta-Tree AI Agent Scheduler 配置
# ==========================================

# 注意：所有业务配置已迁移至 management 数据库（system_configs 表）
# 本文件仅保留基础设施参数

# ==========================================
# 基础设施参数（仅环境变量）
# ==========================================

# 加密配置（自动生成，勿修改）
ENCRYPTION_KEY=

# JWT 认证配置
MANAGEMENT_JWT_SECRET_KEY=your-super-secret-key
MANAGEMENT_JWT_ALGORITHM=HS256
MANAGEMENT_ACCESS_TOKEN_EXPIRE_HOURS=720

# 管理员初始账号（首次启动登录后可通过前端修改）
MANAGEMENT_ADMIN_USERNAME=admin
MANAGEMENT_ADMIN_PASSWORD=Level999

# 服务器配置
MANAGEMENT_SERVER_HOST=0.0.0.0
MANAGEMENT_SERVER_PORT=8001

# 数据库路径
MANAGEMENT_DB_PATH=./management/data/management.db

# Scheduler 内部接口端口（供 management 调用）
SCHEDULER_INTERNAL_PORT=8002

# ==========================================
# 以下为旧版业务配置（已废弃）
# 所有业务配置应通过管理系统前端进行配置，存储在 system_configs 表中
# 首次启动时，管理系统会自动导入以下配置项到数据库
# ==========================================

# ADMIN_KEY=your-admin-key-here
# AI_USER_PASSWORD=ai123456
# API_BASE_URL=http://localhost:8000/api/v1
# LOG_LEVEL=INFO
# LANGGRAPH_MAX_STEPS=20
# LANGGRAPH_MAX_CONSECUTIVE_ERRORS=3
# LANGGRAPH_TOOL_TIMEOUT=30
# LANGGRAPH_ENVIRONMENT_CACHE_TTL=180
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL_NAME=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_NAME=claude-sonnet-4-20250514
# LLM_TEMPERATURE=1.2
# MEMORY_ENABLED=true
# MEMORY_DIR=./memory
# MEMORY_RECALL_LIMIT=5
# MEMORY_RECALL_VECTOR_RESULTS=5
# MEMORY_RECALL_BM25_RESULTS=5
# MEMORY_THRESHOLD=0.3
# MEMORY_BOOST_FACTOR=0.3
# MEMORY_DECAY_RATE=0.01
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
