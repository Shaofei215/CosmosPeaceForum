# ==========================================
# Herta-Tree AI Agent Scheduler 配置
# ==========================================

# 管理员密钥（用于 AI 用户注册）
ADMIN_KEY=your-admin-key-here

# AI 用户默认密码
AI_USER_PASSWORD=ai123456

# API 基础 URL（Docker 部署时使用服务名）
API_BASE_URL=http://backend:8000/api/v1

# AI 用户配置文件路径
AI_USERS_CONFIG_PATH=./ai_users_config.json

# 日志级别
LOG_LEVEL=INFO

# ==========================================
# LangGraph 会话配置
# ==========================================

# LangGraph 最大决策步数（防止无限循环）
LANGGRAPH_MAX_STEPS=10

# 最大连续错误次数（超过后强制退出）
LANGGRAPH_MAX_CONSECUTIVE_ERRORS=3

# 单次工具调用超时时间（秒）
LANGGRAPH_TOOL_TIMEOUT=30

# 环境感知缓存有效期（秒）
LANGGRAPH_ENVIRONMENT_CACHE_TTL=60

# 是否启用环境感知缓存
LANGGRAPH_ENVIRONMENT_CACHE_ENABLED=true

# 是否启用检查点（支持中断恢复）
LANGGRAPH_CHECKPOINTER_ENABLED=true

# ==========================================
# LLM 配置
# ==========================================

# LLM 提供者（openai / anthropic）
LLM_PROVIDER=openai

# OpenAI API 配置
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL_NAME=gpt-4o-mini

# Anthropic API 配置（可选）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_NAME=claude-sonnet-4-20250514

# LLM 温度参数（0.0-2.0，越高越随机）
LLM_TEMPERATURE=0.7

# ==========================================
# 记忆系统配置
# ==========================================

# 是否启用记忆系统
MEMORY_ENABLED=true

# 记忆存储目录
MEMORY_DIR=./memory

# 召回记忆数量
MEMORY_RECALL_LIMIT=5

# 向量检索返回数量
MEMORY_RECALL_VECTOR_RESULTS=5

# BM25 检索返回数量
MEMORY_RECALL_BM25_RESULTS=5

# 记忆系数最低阈值（低于此值的记忆会被删除）
MEMORY_THRESHOLD=0.3

# 唤醒时系数增量（召回时 boost）
MEMORY_BOOST_FACTOR=0.3

# 衰减率（每日）
MEMORY_DECAY_RATE=0.01

# 向量化模型配置
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=your-embedding-api-key-here
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
